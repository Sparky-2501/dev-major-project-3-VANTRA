# Copy to .env, or just run:  node scripts/make-env.js   (it generates the secrets for you)

# --- REQUIRED secrets -------------------------------------------------------
# Signs/verifies login tokens. Anyone who knows it can forge a login. >= 32 random chars.
JWT_SECRET=
# Shared by the gateway and services so services reject calls that did not come
# through the gateway. Also random, different from JWT_SECRET.
INTERNAL_API_KEY=

# --- Optional tuning (defaults shown) ---------------------------------------
# true = demo toggle endpoints and /status exist. Set false for anything non-demo.
DEMO_MODE=true
# Share of payment authorizations that fail, 0..1. Can also be changed live via the demo API.
PAYMENT_FAILURE_RATE=0
# Seconds a driver has to accept a ride offer (N), and how many drivers we try (M).
OFFER_TIMEOUT_SEC=15
MAX_OFFER_ATTEMPTS=3
# Sweep rounds a stuck compensation is retried before the ride is marked FAILED.
MAX_COMPENSATION_ROUNDS=5
# Seconds without a location ping before a driver is dropped from matching.
HEARTBEAT_TTL_SEC=30
# Requests per minute per client IP at the gateway.
RATE_LIMIT_PER_MIN=600
